# Server Configuration
PORT=3001
NODE_ENV=development
DATABASE_URL=file:./data/dating_platform.db

# LLM Integration (Optional - System works deterministically offline without LLM)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Extraction Settings
SCRAPE_TIMEOUT_MS=8000
RATE_LIMIT_DELAY_MS=500
